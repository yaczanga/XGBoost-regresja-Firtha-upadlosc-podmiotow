# Konfiguracja lokalnych sciezek. Skopiuj do .env i uzupelnij.
# Plik .env jest wykluczony z repozytorium.
#
# W projekcie nie wystepuja zadne hasla, klucze API ani poswiadczenia.
# Jedyna zmienna srodowiskowa to sciezka do danych, ktore ze wzgledu
# na rozmiar (3,48 GB) i licencje Orbis leza poza repozytorium.

# Sciezka do zbioru Orbis w formacie Stata (.dta)
DATA_PATH=data/raw/dane.dta
